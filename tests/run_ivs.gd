extends SceneTree

func _init() -> void: call_deferred("run")

func run() -> void:
	var first_rng := RandomNumberGenerator.new()
	first_rng.seed = 2468
	var second_rng := RandomNumberGenerator.new()
	second_rng.seed = 2468
	var first := GameData.make_pokemon("bulbasaur",first_rng)
	var second := GameData.make_pokemon("bulbasaur",second_rng)
	assert(first.ivs == second.ivs)
	assert(first.ivs.size() == 6)
	for value in first.ivs.values(): assert(value >= 0 and value <= 31)
	var snapshot := first.duplicate(true)
	for i in 5: ItemMechanics.initialize(first)
	assert(first == snapshot)
	var restored: Dictionary = JSON.parse_string(JSON.stringify(first))
	ItemMechanics.initialize(restored)
	assert(restored.ivs == first.ivs and int(restored.max_hp) == int(first.max_hp))
	var legacy := snapshot.duplicate(true)
	legacy.erase("ivs")
	legacy.erase("iv_stat_bonuses")
	var legacy_copy := legacy.duplicate(true)
	ItemMechanics.initialize(legacy)
	ItemMechanics.initialize(legacy_copy)
	assert(legacy.ivs == legacy_copy.ivs)
	var zero := GameData.make_pokemon("squirtle")
	for key in ItemMechanics.IV_STATS: zero.ivs[key] = 0
	ItemMechanics.apply_iv_bonuses(zero)
	var perfect := zero.duplicate(true)
	for key in ItemMechanics.IV_STATS: perfect.ivs[key] = 31
	ItemMechanics.apply_iv_bonuses(perfect)
	ItemMechanics.grant_experience(zero,2000000)
	ItemMechanics.grant_experience(perfect,2000000)
	assert(int(perfect.max_hp)-int(zero.max_hp) == 31)
	assert(int(perfect.attack)-int(zero.attack) == 31)
	var fainted := zero.duplicate(true)
	fainted.hp = 0
	fainted.ivs.hp = 31
	ItemMechanics.apply_iv_bonuses(fainted)
	assert(fainted.hp == 0)
	assert(ItemMechanics.iv_judgment(0) == "No good")
	assert(ItemMechanics.iv_judgment(31) == "Best")
	var encounter := RogueRules.encounter(12345,40)
	assert(encounter == RogueRules.encounter(12345,40))
	for enemy in encounter.enemies:
		for stat_name in ItemMechanics.IV_STATS:
			assert(int(enemy.iv_stat_bonuses[stat_name]) == int(int(enemy.ivs[stat_name])*int(enemy.level)/100.0))
	var malformed := snapshot.duplicate(true)
	malformed.ivs = {"hp":99,"attack":-10}
	ItemMechanics.initialize(malformed)
	assert(malformed.ivs.hp == 31 and malformed.ivs.attack == 0 and malformed.ivs.size() == 6)
	var game = load("res://scenes/Main.tscn").instantiate()
	root.add_child(game)
	game.start_new_game("bulbasaur")
	game.state.reserve.append(perfect)
	game.show_party()
	game.show_pokemon_summary(0)
	assert(game.screen == game.Screen.SUMMARY)
	var summary = game.ui.get_child(0)
	for title in ["Overview","Stats","IV Judge","Moves"]:
		summary.tab = title
		summary.rebuild()
	game.close_pokemon_summary()
	assert(game.screen == game.Screen.PARTY)
	game.show_box()
	game.show_pokemon_summary(0,true)
	assert(game.ui.get_child(0).collection[0].ivs == perfect.ivs)
	game.close_pokemon_summary()
	assert(game.screen == game.Screen.BOX)
	game.start_battle("meadow_1","meadow")
	var battle_before: Dictionary = game.battle.duplicate(true)
	var action_before: int = game.action_index
	game.show_pokemon_summary(0)
	game.close_pokemon_summary()
	assert(game.screen == game.Screen.BATTLE)
	assert(game.action_index == action_before and game.battle == battle_before)
	assert(game.save_game())
	var saved_ivs: Dictionary = game.state.party[0].ivs.duplicate()
	assert(game.load_game())
	assert(game.state.party[0].ivs == saved_ivs)
	game.show_box()
	var reserve_ivs: Dictionary = game.state.reserve[0].ivs.duplicate()
	game.swap_box_pokemon(0)
	assert(game.state.party[0].ivs == reserve_ivs)
	assert(game.state.reserve[0].ivs == saved_ivs)
	print("IV generation, stat growth, migration, save and summary navigation tests passed.")
	game.queue_free()
	quit()
